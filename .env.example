# ── Veri modu ──────────────────────────────────────────────
# Demo (şu an): NUXT_PUBLIC_USE_AFTERSHIP ayarlama veya false bırak
# Canlı: aşağıdaki iki satırı Vercel Environment Variables'a ekle

NUXT_PUBLIC_USE_AFTERSHIP=false
AFTERSHIP_API_KEY=

# Canlıya geçince:
# NUXT_PUBLIC_USE_AFTERSHIP=true
# AFTERSHIP_API_KEY=asat_xxxxxxxx   ← https://organization.automizely.com/api-keys
